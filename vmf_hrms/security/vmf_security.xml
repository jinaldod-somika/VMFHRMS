<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Group Privilege (Odoo 19 style) -->
    <record id="res_groups_privilege_vmg_hrms" model="res.groups.privilege">
        <field name="name">VMG HRMS</field>
        <field name="sequence">20</field>
        <field name="category_id" ref="base.module_category_human_resources"/>
    </record>

    <!-- Groups — ordered from lowest to highest access -->
    <record id="group_vmf_employee" model="res.groups">
        <field name="name">Employee (ESS)</field>
        <field name="privilege_id" ref="res_groups_privilege_vmg_hrms"/>
        <field name="implied_ids" eval="[(6, 0, [ref('base.group_user')])]"/>
        <field name="sequence">10</field>
    </record>

    <record id="group_vmf_travel_desk" model="res.groups">
        <field name="name">Travel Desk Coordinator</field>
        <field name="privilege_id" ref="res_groups_privilege_vmg_hrms"/>
        <field name="implied_ids" eval="[(4, ref('group_vmf_employee'))]"/>
        <field name="sequence">15</field>
    </record>

    <record id="group_vmf_manager" model="res.groups">
        <field name="name">Manager (MSS)</field>
        <field name="privilege_id" ref="res_groups_privilege_vmg_hrms"/>
        <field name="implied_ids" eval="[(4, ref('group_vmf_employee'))]"/>
        <field name="sequence">20</field>
    </record>

    <record id="group_vmf_recruiter" model="res.groups">
        <field name="name">Recruiter / Talent Acquisition</field>
        <field name="privilege_id" ref="res_groups_privilege_vmg_hrms"/>
        <field name="implied_ids" eval="[(6, 0, [ref('group_vmf_employee')])]"/>
        <field name="sequence">30</field>
    </record>

    <record id="group_vmf_hr_manager" model="res.groups">
        <field name="name">Business HR Manager</field>
        <field name="privilege_id" ref="res_groups_privilege_vmg_hrms"/>
        <field name="implied_ids" eval="[(6, 0, [ref('group_vmf_recruiter'), ref('group_vmf_travel_desk'), ref('hr.group_hr_user'), ref('group_vmf_manager')])]"/>
        <field name="sequence">40</field>
    </record>

    <record id="group_vmf_payroll" model="res.groups">
        <field name="name">Payroll Officer</field>
        <field name="privilege_id" ref="res_groups_privilege_vmg_hrms"/>
        <field name="implied_ids" eval="[(6, 0, [ref('group_vmf_employee'), ref('group_vmf_travel_desk'), ref('om_hr_payroll.group_hr_payroll_manager')])]"/>
        <field name="sequence">50</field>
    </record>

    <record id="group_vmf_group_hr" model="res.groups">
        <field name="name">Group HR Director</field>
        <field name="privilege_id" ref="res_groups_privilege_vmg_hrms"/>
        <field name="implied_ids" eval="[(6, 0, [ref('group_vmf_payroll'), ref('group_vmf_hr_manager')])]"/>
        <field name="sequence">60</field>
    </record>

    <record id="base.group_system" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('group_vmf_group_hr'))]"/>
    </record>

    <record id="group_vmf_auditor" model="res.groups">
        <field name="name">HR Auditor (Read-Only)</field>
        <field name="privilege_id" ref="res_groups_privilege_vmg_hrms"/>
        <field name="implied_ids" eval="[(6, 0, [ref('base.group_user')])]"/>
        <field name="sequence">70</field>
    </record>

    <!-- Record Rules (noupdate) -->
    <data noupdate="0">
        <record id="rule_mrf_company" model="ir.rule">
            <field name="name">MRF: Company-based access</field>
            <field name="model_id" ref="vmf_hrms.model_vmf_mrf"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(5, 0, 0)]"/>
        </record>

        <record id="rule_candidate_company" model="ir.rule">
            <field name="name">Candidate: Company-based access</field>
            <field name="model_id" ref="vmf_hrms.model_vmf_candidate"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(5, 0, 0)]"/>
        </record>

        <record id="rule_payslip_payroll_only" model="ir.rule">
            <field name="name">Payslip: Payroll group company access</field>
            <field name="model_id" ref="vmf_hrms.model_vmf_payslip"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('group_vmf_payroll')), (4, ref('group_vmf_auditor'))]"/>
        </record>

        <record id="rule_payslip_own_employee" model="ir.rule">
            <field name="name">Payslip: Own payslips for ESS</field>
            <field name="model_id" ref="vmf_hrms.model_vmf_payslip"/>
            <field name="domain_force">[('employee_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_vmf_employee'))]"/>
        </record>

        <record id="rule_travel_company" model="ir.rule">
            <field name="name">Travel: Company-based access</field>
            <field name="model_id" ref="vmf_hrms.model_vmf_travel_request"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('group_vmf_hr_manager')), (4, ref('group_vmf_travel_desk')), (4, ref('group_vmf_auditor'))]"/>
        </record>

        <record id="rule_travel_own_employee" model="ir.rule">
            <field name="name">Travel: Own requests for ESS</field>
            <field name="model_id" ref="vmf_hrms.model_vmf_travel_request"/>
            <field name="domain_force">[('employee_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_vmf_employee'))]"/>
        </record>

        <record id="rule_grievance_own" model="ir.rule">
            <field name="name">Grievance: Own cases for ESS</field>
            <field name="model_id" ref="vmf_hrms.model_vmf_grievance"/>
            <field name="domain_force">[('employee_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_vmf_employee'))]"/>
        </record>

        <record id="rule_grievance_company" model="ir.rule">
            <field name="name">Grievance: Company-based for HR</field>
            <field name="model_id" ref="vmf_hrms.model_vmf_grievance"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('group_vmf_hr_manager')), (4, ref('group_vmf_auditor'))]"/>
        </record>

        <record id="rule_pip_own_employee" model="ir.rule">
            <field name="name">PIP: Own plans for ESS</field>
            <field name="model_id" ref="vmf_hrms.model_vmf_pip"/>
            <field name="domain_force">[('employee_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_vmf_employee'))]"/>
        </record>

        <record id="rule_pip_company" model="ir.rule">
            <field name="name">PIP: Company-based for HR</field>
            <field name="model_id" ref="vmf_hrms.model_vmf_pip"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('group_vmf_hr_manager')), (4, ref('group_vmf_auditor'))]"/>
        </record>

        <record id="rule_pip_manager" model="ir.rule">
            <field name="name">PIP: Subordinates plans for Manager</field>
            <field name="model_id" ref="vmf_hrms.model_vmf_pip"/>
            <field name="domain_force">[('manager_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_vmf_manager'))]"/>
        </record>

        <!-- Admin absolute bypass rules -->
        <record id="rule_payslip_admin" model="ir.rule">
            <field name="name">Payslip: Admin absolute bypass</field>
            <field name="model_id" ref="vmf_hrms.model_vmf_payslip"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('base.group_system'))]"/>
        </record>

        <record id="rule_travel_admin" model="ir.rule">
            <field name="name">Travel: Admin absolute bypass</field>
            <field name="model_id" ref="vmf_hrms.model_vmf_travel_request"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('base.group_system'))]"/>
        </record>

        <record id="rule_grievance_admin" model="ir.rule">
            <field name="name">Grievance: Admin absolute bypass</field>
            <field name="model_id" ref="vmf_hrms.model_vmf_grievance"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('base.group_system'))]"/>
        </record>

        <record id="rule_pip_admin" model="ir.rule">
            <field name="name">PIP: Admin absolute bypass</field>
            <field name="model_id" ref="vmf_hrms.model_vmf_pip"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('base.group_system'))]"/>
        </record>

        <!-- Performance Review record rules -->
        <record id="rule_performance_review_own_employee" model="ir.rule">
            <field name="name">Performance Review: Own reviews for ESS</field>
            <field name="model_id" ref="vmf_hrms.model_vmf_performance_review"/>
            <field name="domain_force">[('employee_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_vmf_employee'))]"/>
        </record>

        <record id="rule_performance_review_all_management" model="ir.rule">
            <field name="name">Performance Review: Global for Management and HR</field>
            <field name="model_id" ref="vmf_hrms.model_vmf_performance_review"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_vmf_manager')), (4, ref('group_vmf_hr_manager')), (4, ref('group_vmf_group_hr'))]"/>
        </record>

        <record id="rule_performance_review_company" model="ir.rule">
            <field name="name">Performance Review: Company-based for HR</field>
            <field name="model_id" ref="vmf_hrms.model_vmf_performance_review"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('group_vmf_auditor'))]"/>
        </record>

        <record id="rule_performance_review_admin" model="ir.rule">
            <field name="name">Performance Review: Admin absolute bypass</field>
            <field name="model_id" ref="vmf_hrms.model_vmf_performance_review"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('base.group_system'))]"/>
        </record>

        <!-- Goal record rules -->
        <record id="rule_vmf_goal_employee" model="ir.rule">
            <field name="name">Goal: Own goals for employee</field>
            <field name="model_id" ref="vmf_hrms.model_vmf_goal"/>
            <field name="domain_force">[('employee_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_vmf_employee'))]"/>
        </record>

        <record id="rule_vmf_goal_manager" model="ir.rule">
            <field name="name">Goal: Manager own and team goals (company restricted)</field>
            <field name="model_id" ref="vmf_hrms.model_vmf_goal"/>
            <field name="domain_force">['&amp;', ('company_id', 'in', company_ids), '|', '|', ('employee_id.user_id', '=', user.id), ('employee_id.parent_id.user_id', '=', user.id), ('employee_id.vmf_hod2_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_vmf_manager'))]"/>
        </record>

        <record id="rule_vmf_goal_hr" model="ir.rule">
            <field name="name">Goal: Multi-company goals for HR and Auditor</field>
            <field name="model_id" ref="vmf_hrms.model_vmf_goal"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('group_vmf_hr_manager')), (4, ref('group_vmf_group_hr')), (4, ref('group_vmf_auditor'))]"/>
        </record>

        <record id="rule_vmf_goal_admin" model="ir.rule">
            <field name="name">Goal: Admin absolute bypass</field>
            <field name="model_id" ref="vmf_hrms.model_vmf_goal"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('base.group_system'))]"/>
        </record>
    </data>
</odoo>
