<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Hold Wizard -->
    <record id="view_vmf_candidate_hold_wizard_form" model="ir.ui.view">
        <field name="name">vmf.candidate.hold.wizard.form</field>
        <field name="model">vmf.candidate.hold.wizard</field>
        <field name="arch" type="xml">
            <form string="Put Candidate On Hold">
                <sheet>
                    <group>
                        <field name="candidate_id"/>
                        <field name="hold_reason"/>
                        <field name="expected_resume_date"/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_confirm_hold" string="Confirm Hold" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_vmf_candidate_hold_wizard" model="ir.actions.act_window">
        <field name="name">Put Candidate On Hold</field>
        <field name="res_model" >vmf.candidate.hold.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="context">{'default_candidate_id': active_id}</field>
    </record>

    <!-- Drop Wizard -->
    <record id="view_vmf_candidate_drop_wizard_form" model="ir.ui.view">
        <field name="name">vmf.candidate.drop.wizard.form</field>
        <field name="model">vmf.candidate.drop.wizard</field>
        <field name="arch" type="xml">
            <form string="Candidate Offer Drop">
                <sheet>
                    <group>
                        <field name="candidate_id"/>
                        <field name="drop_stage"/>
                        <field name="drop_reason"/>
                        <field name="notes"/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_confirm_drop" string="Confirm Drop" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_vmf_candidate_drop_wizard" model="ir.actions.act_window">
        <field name="name">Candidate Offer Drop</field>
        <field name="res_model">vmf.candidate.drop.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="context">{'default_candidate_id': active_id}</field>
    </record>

