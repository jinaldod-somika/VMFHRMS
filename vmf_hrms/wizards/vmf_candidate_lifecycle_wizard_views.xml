    <!-- Visa Wizard -->
    <record id="view_vmf_candidate_visa_wizard_form" model="ir.ui.view">
        <field name="name">vmf.candidate.visa.wizard.form</field>
        <field name="model">vmf.candidate.visa.wizard</field>
