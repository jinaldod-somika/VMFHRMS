        <field name="name">vmf.candidate.medical.wizard.form</field>
        <field name="model">vmf.candidate.medical.wizard</field>
        <field name="arch" type="xml">
            <form string="Medical Clearance">
                <sheet>
                    <group>
                        <field name="candidate_id"/>
                        <field name="medical_status"/>
                        <field name="medical_clearance_date"/>
                        <field name="medical_remarks"/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_confirm_medical" string="Save" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_vmf_candidate_medical_wizard" model="ir.actions.act_window">
        <field name="name">Medical Clearance</field>
        <field name="res_model">vmf.candidate.medical.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="context">{'default_candidate_id': active_id}</field>
    </record>

