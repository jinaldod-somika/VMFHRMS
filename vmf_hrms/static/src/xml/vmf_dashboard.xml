<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="vmf_hrms.Dashboard">
        <div class="vmf_dashboard_container">
            <!-- Header -->
            <div class="vmf_dashboard_header">
                <div>
                    <h1>HR Executive Dashboard</h1>
                    <p class="text-muted">Welcome back! Here's what's happening today.</p>
                </div>
                <div class="vmf_header_actions">
                    <button class="btn btn-primary shadow-sm" t-on-click="loadStats">
                        <i class="fa fa-refresh mr-1"></i> Refresh Data
                    </button>
                </div>
            </div>

            <div t-if="state.loading" class="vmf_loading">
                <div class="spinner-border text-primary" role="status">
                    <span class="sr-only">Loading...</span>
                </div>
            </div>

            <div t-else="">
                <!-- KPI Row -->
                <div class="row mb-4">
                    <div class="col-xl-3 col-md-6 mb-4">
                        <div class="vmf_kpi_card primary" t-on-click="openMRF">
                            <div class="vmf_kpi_content">
                                <div>
                                    <div class="vmf_kpi_label">Open Positions</div>
                                    <div class="vmf_kpi_value"><t t-esc="state.openPositions"/></div>
                                </div>
                                <div class="vmf_kpi_icon">
                                    <i class="fa fa-briefcase"></i>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-xl-3 col-md-6 mb-4">
                        <div class="vmf_kpi_card success" t-on-click="openTravel">
                            <div class="vmf_kpi_content">
                                <div>
                                    <div class="vmf_kpi_label">Travel Requests</div>
                                    <div class="vmf_kpi_value"><t t-esc="state.travelRequests"/></div>
                                </div>
                                <div class="vmf_kpi_icon">
                                    <i class="fa fa-plane"></i>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-xl-3 col-md-6 mb-4">
                        <div class="vmf_kpi_card warning" t-on-click="openGrievances">
                            <div class="vmf_kpi_content">
                                <div>
                                    <div class="vmf_kpi_label">Open Grievances</div>
                                    <div class="vmf_kpi_value"><t t-esc="state.openGrievances"/></div>
                                </div>
                                <div class="vmf_kpi_icon">
                                    <i class="fa fa-exclamation-triangle"></i>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-xl-3 col-md-6 mb-4">
                        <div class="vmf_kpi_card info">
                            <div class="vmf_kpi_content">
                                <div>
                                    <div class="vmf_kpi_label">Total Employees</div>
                                    <div class="vmf_kpi_value"><t t-esc="state.totalEmployees"/></div>
                                </div>
                                <div class="vmf_kpi_icon">
                                    <i class="fa fa-users"></i>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Secondary Row -->
                <div class="row">
                    <!-- Quick Actions -->
                    <div class="col-lg-4 mb-4">
                        <div class="vmf_action_card">
                            <h5>Quick Actions</h5>
                            <a href="#" class="vmf_quick_btn" t-on-click="openMRF">
                                <i class="fa fa-plus-circle text-primary"></i> Create New Requisition
                            </a>
                            <a href="#" class="vmf_quick_btn" t-on-click="openTravel">
                                <i class="fa fa-paper-plane text-success"></i> Submit Travel Request
                            </a>
                            <a href="#" class="vmf_quick_btn" t-on-click="openGrievances">
                                <i class="fa fa-comments text-warning"></i> Log a Grievance
                            </a>
                        </div>
                    </div>

                    <!-- Module Overview -->
                    <div class="col-lg-8 mb-4">
                        <div class="vmf_action_card">
                            <h5>Module Overview</h5>
                            <div class="p-4 text-center">
                                <p class="text-muted">Detailed analytics and trend charts will appear here as more data is collected.</p>
                                <div class="mt-4">
                                    <i class="fa fa-bar-chart fa-4x text-light"></i>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </t>
</templates>
