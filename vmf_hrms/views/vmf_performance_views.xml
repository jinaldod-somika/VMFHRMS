<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Goal Plan -->
    <record id="view_vmf_goal_plan_form" model="ir.ui.view">
        <field name="name">vmf.goal.plan.form</field>
        <field name="model">vmf.goal.plan</field>
        <field name="arch" type="xml">
            <form string="Goal Plan">
                <header>
                    <button name="action_publish" string="Publish" type="object"
                            invisible="state != 'draft'" class="btn-primary"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,published,closed"/>
                </header>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="year"/>
                        <field name="company_id"/>
                        <field name="description"/>
                    </group>
                    <field name="goal_ids">
                        <list editable="bottom">
                            <field name="name"/>
                            <field name="weight"/>
                            <field name="bsc_perspective"/>
                            <field name="start_date"/>
                            <field name="target_date"/>
                        </list>
                    </field>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_vmf_goal_plan" model="ir.actions.act_window">
        <field name="name">Goal Plans</field>
        <field name="res_model">vmf.goal.plan</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Performance Review -->
    <record id="view_vmf_performance_review_form" model="ir.ui.view">
        <field name="name">vmf.performance.review.form</field>
        <field name="model">vmf.performance.review</field>
        <field name="arch" type="xml">
            <form string="Performance Review">
                <header>
                    <button name="action_acknowledge" string="Acknowledge Goals" type="object"
                            invisible="state != 'draft'" class="btn-primary"/>
                    <button name="action_start_self_appraisal" string="Start Self Appraisal" type="object"
                            invisible="state != 'acknowledged'" class="btn-primary"/>
                    <button name="%(action_vmf_self_appraisal_wizard)d" string="Submit Self Appraisal" type="action"
                            invisible="state != 'self_appraisal'" class="btn-primary"/>
                    <button name="action_submit_manager" string="Submit Manager Review" type="object"
                            invisible="state != 'manager_review'"
                            groups="vmf_hrms.group_vmf_manager" class="btn-success"/>
                    <button name="action_release_rating" string="Release Rating" type="object"
                            invisible="state != 'calibration'"
                            groups="vmf_hrms.group_vmf_hr_manager" class="btn-warning"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,acknowledged,self_appraisal,manager_review,calibration,released"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="employee_id"/>
                            <field name="manager_id" readonly="1"/>
                            <field name="company_id" readonly="1"/>
                            <field name="department_id" readonly="1"/>
                            <field name="grade_id" readonly="1"/>
                        </group>
                        <group>
                            <field name="review_type"/>
                            <field name="review_period_year"/>
                            <field name="review_period_quarter"/>
                            <field name="date_review"/>
                            <field name="date_due"/>
                        </group>
                    </group>
                    <group string="Overall Ratings">
                        <group>
                            <field name="self_rating"/>
                            <field name="manager_rating"/>
                            <field name="final_rating"/>
                        </group>
                        <group>
                            <field name="rating_band" readonly="1"/>
                            <field name="increment_recommended"/>
                            <field name="promotion_recommended"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="KPI Ratings">
                            <field name="goal_line_ids">
                                <list editable="bottom">
                                    <field name="sequence"/>
                                    <field name="name"/>
                                    <field name="weight"/>
                                    <field name="target"/>
                                    <field name="unit"/>
                                    <field name="actual_achievement"/>
                                    <field name="self_rating"/>
                                    <field name="manager_rating"/>
                                    <field name="final_rating"/>
                                    <field name="weighted_score" readonly="1"/>
                                </list>
                            </field>
                        </page>
                        <page string="Comments">
                            <group>
                                <field name="self_appraisal_comments"/>
                                <field name="manager_comments"/>
                                <field name="calibration_comments"/>
                            </group>
                        </page>
                        <page string="Development">
                            <group>
                                <field name="strengths"/>
                                <field name="areas_for_improvement"/>
                                <field name="development_actions"/>
                            </group>
                            <group>
                                <field name="pip_initiated"/>
                                <field name="pip_id" invisible="pip_initiated == False"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_vmf_performance_review_list" model="ir.ui.view">
        <field name="name">vmf.performance.review.list</field>
        <field name="model">vmf.performance.review</field>
        <field name="arch" type="xml">
            <list string="Performance Reviews">
                <field name="name"/>
                <field name="employee_id"/>
                <field name="company_id"/>
                <field name="department_id"/>
                <field name="review_type"/>
                <field name="review_period_year"/>
                <field name="date_review"/>
                <field name="final_rating"/>
                <field name="rating_band"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'released'"
                       decoration-info="state == 'acknowledged'"
                       decoration-warning="state in ['self_appraisal','manager_review']"/>
            </list>
        </field>
    </record>

    <record id="action_vmf_performance_review" model="ir.actions.act_window">
        <field name="name">Performance Reviews</field>
        <field name="res_model">vmf.performance.review</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- PIP -->
    <record id="view_vmf_pip_form" model="ir.ui.view">
        <field name="name">vmf.pip.form</field>
        <field name="model">vmf.pip</field>
        <field name="arch" type="xml">
            <form string="PIP">
                <header>
                    <button name="action_close_improved" string="Close — Improved" type="object"
                            invisible="state != 'active'" class="btn-success"/>
                    <button name="action_close_exited" string="Close — Exit Process" type="object"
                            invisible="state != 'active'" class="btn-danger"/>
                    <field name="state" widget="statusbar" statusbar_visible="active,extended,closed_improved,closed_exited"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="employee_id"/>
                            <field name="manager_id" readonly="1"/>
                            <field name="date_initiated"/>
                            <field name="date_end"/>
                            <field name="duration_weeks"/>
                        </group>
                    </group>
                    <group>
                        <field name="improvement_areas"/>
                        <field name="expected_outcomes"/>
                        <field name="support_provided"/>
                        <field name="closure_reason"/>
                    </group>
                    <field name="review_checkpoint_ids">
                        <list editable="bottom">
                            <field name="checkpoint_date"/>
                            <field name="reviewer_id"/>
                            <field name="rating"/>
                            <field name="progress_notes"/>
                            <field name="outcome"/>
                        </list>
                    </field>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_vmf_pip" model="ir.actions.act_window">
        <field name="name">Performance Improvement Plans</field>
        <field name="res_model">vmf.pip</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Goal Form View -->
    <record id="view_vmf_goal_form" model="ir.ui.view">
        <field name="name">vmf.goal.form</field>
        <field name="model">vmf.goal</field>
        <field name="arch" type="xml">
            <form string="Goal Details">
                <header>
                    <button name="action_submit" string="Submit to HOD 1" type="object"
                            invisible="state != 'draft'" class="btn-primary"/>
                    <button name="action_hod1_approve" string="Approve (HOD 1)" type="object"
                            invisible="state != 'submitted'" class="btn-success"/>
                    <button name="action_hod2_approve" string="Approve (HOD 2)" type="object"
                            invisible="state != 'hod1_approved'" class="btn-success"/>
                    <button name="action_reject" string="Reject / Need Info" type="object"
                            invisible="state not in ['submitted', 'hod1_approved']" class="btn-danger"/>
                    <button name="action_cancel" string="Cancel" type="object"
                            invisible="state in ['achieved', 'cancelled']"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,submitted,hod1_approved,achieved"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only"/>
                        <h1>
                            <field name="name" placeholder="e.g. Expand Market Share in APAC" readonly="state != 'draft'"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Employee Info">
                            <field name="employee_id" readonly="state != 'draft'"/>
                            <field name="plan_id" readonly="state != 'draft'"/>
                            <field name="manager_id" readonly="1"/>
                            <field name="hod2_id" readonly="1"/>
                        </group>
                        <group string="Organization Info">
                            <field name="company_id" readonly="1"/>
                            <field name="department_id" readonly="1"/>
                            <field name="job_id" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Goal Details">
                            <group>
                                <group>
                                    <field name="weight" readonly="state != 'draft'"/>
                                    <field name="bsc_perspective" readonly="state != 'draft'"/>
                                    <field name="review_frequency" readonly="state != 'draft'"/>
                                </group>
                                <group>
                                    <field name="start_date" readonly="state in ['achieved', 'cancelled']"/>
                                    <field name="target_date" readonly="state in ['achieved', 'cancelled']"/>
                                </group>
                            </group>
                            <group>
                                <field name="statement" readonly="state != 'draft'"/>
                                <field name="success_measure" readonly="state != 'draft'"/>
                                <field name="comments" readonly="state != 'draft'"/>
                            </group>
                        </page>
                        <page string="Execution Steps">
                            <group>
                                <field name="milestone_not_sure" readonly="state != 'draft'"/>
                            </group>
                            <field name="milestone_ids" invisible="milestone_not_sure == True" readonly="state in ['achieved', 'cancelled']">
                                <list editable="bottom">
                                    <field name="measure" readonly="parent.state in ['achieved', 'cancelled']"/>
                                    <field name="description" readonly="parent.state in ['achieved', 'cancelled']"/>
                                    <field name="completion_date" readonly="parent.state in ['achieved', 'cancelled']"/>
                                    <field name="hod1_comment" readonly="parent.state != 'submitted'"/>
                                    <field name="hod2_comment" readonly="parent.state != 'hod1_approved'"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Goal Tree View -->
    <record id="view_vmf_goal_list" model="ir.ui.view">
        <field name="name">vmf.goal.list</field>
        <field name="model">vmf.goal</field>
        <field name="arch" type="xml">
            <list string="Goals">
                <field name="name"/>
                <field name="plan_id"/>
                <field name="employee_id"/>
                <field name="manager_id"/>
                <field name="hod2_id"/>
                <field name="weight"/>
                <field name="bsc_perspective"/>
                <field name="target_date"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'achieved'"
                       decoration-info="state == 'submitted'"
                       decoration-warning="state == 'hod1_approved'"/>
            </list>
        </field>
    </record>

    <!-- Goal Search View -->
    <record id="view_vmf_goal_search" model="ir.ui.view">
        <field name="name">vmf.goal.search</field>
        <field name="model">vmf.goal</field>
        <field name="arch" type="xml">
            <search string="Search Goals">
                <field name="name" string="Goal Name"/>
                <field name="employee_id"/>
                <field name="manager_id"/>
                <field name="hod2_id"/>
                <filter string="My Goals" name="my_goals" domain="[('employee_id.user_id', '=', uid)]"/>
                <filter string="Draft" name="draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Submitted" name="submitted" domain="[('state', '=', 'submitted')]"/>
                <filter string="HOD 1 Approved" name="hod1_approved" domain="[('state', '=', 'hod1_approved')]"/>
                <filter string="Achieved" name="achieved" domain="[('state', '=', 'achieved')]"/>
                <separator/>
                <filter string="By Employee" name="group_employee" context="{'group_by': 'employee_id'}"/>
                <filter string="By Manager (HOD 1)" name="group_manager" context="{'group_by': 'manager_id'}"/>
                <filter string="By Status" name="group_status" context="{'group_by': 'state'}"/>
                <filter string="By BSC Perspective" name="group_bsc" context="{'group_by': 'bsc_perspective'}"/>
            </search>
        </field>
    </record>

    <!-- Action for standalone goals -->
    <record id="action_vmf_goal" model="ir.actions.act_window">
        <field name="name">Goals</field>
        <field name="res_model">vmf.goal</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_vmf_goal_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new goal plan for professional or organizational achievements.
            </p>
        </field>
    </record>
</odoo>
