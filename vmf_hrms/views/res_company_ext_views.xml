<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Extend Company form to add VMG fields -->
    <record id="view_res_company_form_vmf" model="ir.ui.view">
        <field name="name">res.company.form.vmf</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <notebook>
                    <page string="VMG Configuration" name="vmg_config">
                        <group>
                            <group string="Group Identifiers">
                                <field name="vmf_company_code" placeholder="e.g. VMS-DRC"/>
                                <field name="vmf_short_name" placeholder="e.g. VMS"/>
                                <field name="vmf_company_type"/>
                            </group>
                            <group string="Group Notes">
                                <field name="vmf_notes" nolabel="1" colspan="2"
                                       placeholder="Internal notes about this company..."/>
                            </group>
                        </group>
                    </page>
                </notebook>
            </xpath>
        </field>
    </record>

    <!-- Add Company Code column to companies list -->
    <record id="view_res_company_list_vmf" model="ir.ui.view">
        <field name="name">res.company.list.vmf</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="before">
                <field name="vmf_company_code" string="Code"/>
            </xpath>
            <xpath expr="//field[@name='name']" position="after">
                <field name="vmf_short_name" string="Short Name" optional="show"/>
                <field name="vmf_company_type" string="Type" optional="show"/>
            </xpath>
        </field>
    </record>

    <!-- Direct action for VMG Companies (so it appears under VMG Configuration menu) -->
    <record id="action_vmf_company" model="ir.actions.act_window">
        <field name="name">Companies</field>
        <field name="res_model">res.company</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
