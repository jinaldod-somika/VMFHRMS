<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_vmf_candidate_form" model="ir.ui.view">
        <field name="name">vmf.candidate.form</field>
        <field name="model">vmf.candidate</field>
        <field name="arch" type="xml">
            <form string="Candidate">
                <header>
                    <button name="action_move_to_screening" string="Screening" type="object"
                            invisible="state != 'new'" class="btn-primary"/>
                    <button name="action_open_invitation_wizard" string="1st Round Invitation" type="object"
                            invisible="state != 'screening'" class="btn-primary"/>
                    <button name="action_schedule_interview1" string="Move to 1st Round" type="object"
                            invisible="state != 'invitation_1'" class="btn-primary"/>
                    
                    <button name="action_open_invitation_wizard" string="2nd Round Invitation" type="object"
                            invisible="state != 'interview_1' or interview1_result != 'cleared'"/>
                    <button name="action_schedule_interview2" string="Move to 2nd Round" type="object"
                            invisible="state != 'invitation_2'"/>

                    <button name="action_open_invitation_wizard" string="3rd Round Invitation" type="object"
                            invisible="state != 'interview_2' or interview2_result != 'cleared'"/>
                    <button name="action_schedule_interview3" string="Move to 3rd Round" type="object"
                            invisible="state != 'invitation_3'"/>

                    <button name="action_open_feedback_wizard" string="Submit Feedback" type="object"
                            invisible="state not in ['interview_1','interview_2','interview_3']" class="btn-info"/>
                    <button name="action_select" string="Select Candidate" type="object"
                            invisible="state not in ['interview_1','interview_2','interview_3','assessment']"
                            class="btn-success"/>
                    <button name="action_prepare_offer" string="Prepare Offer" type="object"
                            invisible="state != 'selected'"/>
                    <button name="action_release_offer" string="Release Offer" type="object"
                            invisible="state != 'offer_prepared'"/>
                    <button name="action_accept_offer" string="Offer Accepted" type="object"
                            invisible="state != 'offer_released'"/>
                    
                    <!-- Wizards -->
                    <button name="%(action_vmf_candidate_bgv_wizard)d" string="Update BGV" type="action"
                            invisible="state != 'offer_accepted'"/>
                    <button name="%(action_vmf_candidate_medical_wizard)d" string="Update Medical" type="action"
                            invisible="state != 'bgv'"/>
                    <button name="%(action_vmf_candidate_visa_wizard)d" string="Update Visa / PEC" type="action"
                            invisible="state not in ['bgv', 'medical']"/>
                    
                    <button name="action_confirm_joining" string="Confirm Joining" type="object"
                            invisible="state not in ['bgv', 'medical', 'visa']"/>
                    <button name="action_mark_joined" string="Mark Joined" type="object"
                            invisible="state != 'joining_confirmed'" class="btn-success"/>
                    <button name="action_reject" string="Reject" type="object"
                            invisible="state in ['joined','offer_dropped','rejected']"/>
                    
                    <button name="%(action_vmf_candidate_hold_wizard)d" string="Put On Hold" type="action" 
                            invisible="state in ['joined','rejected','offer_dropped','on_hold']" class="btn-warning"/>
                    <button name="%(action_vmf_candidate_reopen_wizard)d" string="Reopen / Resume" type="action" 
                            invisible="state != 'on_hold'" class="btn-info"/>
                    <button name="%(action_vmf_candidate_drop_wizard)d" string="Cancel / Drop" type="action" 
                            invisible="state in ['joined','rejected','offer_dropped']" class="btn-danger"/>
                    
                    <button name="action_create_employee" string="Create Employee" type="object"
                            invisible="state != 'joined'" class="btn-primary"
                            groups="vmf_hrms.group_vmf_hr_manager"/>
                    <button name="action_print_offer_letter" string="Print Offer Letter" type="object"
                            invisible="state not in ['offer_prepared','offer_released','offer_accepted']"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="new,screening,interview_1,interview_2,interview_3,selected,offer_released,offer_accepted,bgv,joining_confirmed,joined"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/> — <field name="candidate_name"/></h1>
                    </div>
                    <group>
                        <group string="Personal Details">
                            <field name="candidate_name"/>
                            <field name="mobile"/>
                            <field name="email"/>
                        </group>
                        <group string="Position">
                            <field name="mrf_id"/>
                            <field name="company_id" readonly="1"/>
                            <field name="job_id" readonly="1"/>
                            <field name="grade_id" readonly="1"/>
                            <field name="coordinator_id"/>
                            <field name="hiring_manager_id"/>
                        </group>
                    </group>
                    <group>
                        <group string="Sourcing">
                            <field name="sourcing_channel"/>
                            <field name="sourcing_agency"/>
                            <field name="resume_received_date"/>
                            <field name="tat_days"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Documents" name="documents">
                            <group>
                                <field name="candidate_document_ids" widget="many2many_binary" nolabel="1" colspan="2"/>
                            </group>
                        </page>
                        <page string="Interview Rounds">
                            <group string="Round 1">
                                <group>
                                    <field name="interview1_date"/>
                                    <field name="interview1_interviewer_ids" widget="many2many_tags"/>
                                    <field name="interview1_hr_interviewer_id"/>
                                    <field name="interview1_google_meet_link" widget="url"/>
                                </group>
                                <group>
                                    <field name="interview1_result"/>
                                    <field name="interview1_feedback"/>
                                    <field name="interview1_remarks"/>
                                </group>
                            </group>
                            <group string="Round 2">
                                <group>
                                    <field name="interview2_date"/>
                                    <field name="interview2_interviewer_ids" widget="many2many_tags"/>
                                    <field name="interview2_hr_interviewer_id"/>
                                    <field name="interview2_google_meet_link" widget="url"/>
                                </group>
                                <group>
                                    <field name="interview2_result"/>
                                    <field name="interview2_feedback"/>
                                    <field name="interview2_remarks"/>
                                </group>
                            </group>
                            <group string="Round 3">
                                <group>
                                    <field name="interview3_date"/>
                                    <field name="interview3_interviewer_ids" widget="many2many_tags"/>
                                    <field name="interview3_hr_interviewer_id"/>
                                    <field name="interview3_google_meet_link" widget="url"/>
                                </group>
                                <group>
                                    <field name="interview3_result"/>
                                    <field name="interview3_feedback"/>
                                    <field name="interview3_remarks"/>
                                </group>
                            </group>
                            <group string="Assessment">
                                <group>
                                    <field name="assessment_done"/>
                                    <field name="assessment_date"/>
                                </group>
                                <group>
                                    <field name="assessment_result"/>
                                    <field name="assessment_remarks"/>
                                </group>
                            </group>
                        </page>
                        <page string="Offer Details">
                            <group>
                                <group>
                                    <field name="offer_prepared_by"/>
                                    <field name="offer_prepared_date"/>
                                    <field name="offer_released_date"/>
                                    <field name="offer_accepted_date"/>
                                </group>
                                <group>
                                    <field name="offer_currency_id"/>
                                    <field name="current_ctc"/>
                                    <field name="offered_ctc"/>
                                </group>
                            </group>
                        </page>
                        <page string="Pre-Joining Compliance">
                            <group string="Documents &amp; BGV">
                                <group>
                                    <field name="documents_received_date"/>
                                    <field name="bgv_initiated_date"/>
                                    <field name="bgv_completed_date"/>
                                    <field name="bgv_status"/>
                                </group>
                                <group>
                                    <field name="bgv_remarks"/>
                                    <field name="medical_clearance_date"/>
                                    <field name="medical_status"/>
                                </group>
                            </group>
                            <group string="Visa / PEC">
                                <group>
                                    <field name="visa_type"/>
                                    <field name="pec_initiated_date"/>
                                    <field name="visa_received_date"/>
                                </group>
                                <group>
                                    <field name="expected_doj"/>
                                    <field name="actual_doj"/>
                                </group>
                            </group>
                            <group string="Onboarding">
                                <field name="bank_details_updated"/>
                                <field name="joining_circular_dispatched"/>
                                <field name="joining_circular_date"/>
                                <field name="online_onboarding_completed"/>
                            </group>
                        </page>
                        <page string="Drop / Hold Log">
                            <field name="drop_ids">
                                <list editable="bottom">
                                    <field name="drop_date"/>
                                    <field name="drop_stage"/>
                                    <field name="previous_state"/>
                                    <field name="drop_reason"/>
                                    <field name="days_lost"/>
                                    <field name="reinstated"/>
                                </list>
                            </field>
                            <separator string="Hold Log"/>
                            <field name="hold_ids">
                                <list editable="bottom">
                                    <field name="hold_start"/>
                                    <field name="hold_end"/>
                                    <field name="previous_state"/>
                                    <field name="hold_reason"/>
                                    <field name="reopen_reason"/>
                                    <field name="hold_days"/>
                                </list>
                            </field>
                        </page>
                        <page string="Notes">
                            <field name="notes"/>
                            <field name="employee_id" readonly="1"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_vmf_candidate_list" model="ir.ui.view">
        <field name="name">vmf.candidate.list</field>
        <field name="model">vmf.candidate</field>
        <field name="arch" type="xml">
            <list string="Candidates" decoration-success="state == 'joined'"
                  decoration-danger="is_dropped == True">
                <field name="name"/>
                <field name="candidate_name"/>
                <field name="mrf_id"/>
                <field name="company_id"/>
                <field name="job_id"/>
                <field name="grade_id"/>
                <field name="sourcing_channel"/>
                <field name="resume_received_date"/>
                <field name="previous_state" decoration-info="True"/>
                <field name="hold_reason"/>
                <field name="drop_reason"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'joined'"
                       decoration-warning="state in ['offer_released','offer_accepted','bgv','visa','invitation_1','invitation_2','invitation_3']"
                       decoration-info="state in ['interview_1','interview_2','interview_3']"
                       decoration-danger="state in ['offer_dropped','rejected']"/>
                <field name="coordinator_id"/>
                <field name="hiring_manager_id"/>
                <field name="tat_days"/>
            </list>
        </field>
    </record>

    <record id="view_vmf_candidate_kanban" model="ir.ui.view">
        <field name="name">vmf.candidate.kanban</field>
        <field name="model">vmf.candidate</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state">
                <field name="candidate_name"/>
                <field name="state"/>
                <field name="job_id"/>
                <field name="grade_id"/>
                <field name="mrf_id"/>
                <field name="sourcing_channel"/>
                <field name="tat_days"/>
                <templates>
                    <t t-name="card">
                        <strong><field name="candidate_name"/></strong>
                        <div><field name="job_id"/> | <field name="grade_id"/></div>
                        <div><field name="sourcing_channel"/></div>
                        <footer>TAT: <field name="tat_days"/> days</footer>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_vmf_candidate_search" model="ir.ui.view">
        <field name="name">vmf.candidate.search</field>
        <field name="model">vmf.candidate</field>
        <field name="arch" type="xml">
            <search string="Search Candidates">
                <field name="candidate_name"/>
                <field name="mrf_id"/>
                <field name="company_id"/>
                <field name="coordinator_id"/>
                <field name="hiring_manager_id"/>
                <filter string="Joined" name="joined" domain="[('state','=','joined')]"/>
                <filter string="In Pipeline" name="pipeline" domain="[('state','not in',['joined','offer_dropped','rejected'])]"/>
                <filter string="Offer Released" name="offer_released" domain="[('state','=','offer_released')]"/>
                <group>
                    <filter string="Company" name="by_company" context="{'group_by': 'company_id'}"/>
                    <filter string="Position" name="by_mrf" context="{'group_by': 'mrf_id'}"/>
                    <filter string="Stage" name="by_state" context="{'group_by': 'state'}"/>
                    <filter string="Source" name="by_channel" context="{'group_by': 'sourcing_channel'}"/>
                    <filter string="Recruiter" name="by_coordinator" context="{'group_by': 'coordinator_id'}"/>
                    <filter string="Hiring Manager" name="by_hiring_manager" context="{'group_by': 'hiring_manager_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_vmf_candidate" model="ir.actions.act_window">
        <field name="name">Candidates</field>
        <field name="res_model">vmf.candidate</field>
        <field name="view_mode">list,kanban,form</field>
    </record>
</odoo>
